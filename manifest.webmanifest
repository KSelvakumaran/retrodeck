{
  "name": "Retrodeck",
  "short_name": "Retrodeck",
  "description": "A tape-deck style Spotify player.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#CDD3D9",
  "theme_color": "#CDD3D9",
  "icons": [
